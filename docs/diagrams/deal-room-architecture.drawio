        <mxCell id="netn" value="Turned on and the data plane leaves the public internet entirely: VNet integration on the environment, private endpoints on storage and Cosmos, private DNS for the lookups." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#44546A;" vertex="1" parent="net"><mxGeometry x="12" y="262" width="276" height="60" as="geometry" /></mxCell>
