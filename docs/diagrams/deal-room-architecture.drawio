        <mxCell id="secn" value="RBAC grants the identity exactly what it needs: blob data on the storage account, inference on the models, get on the vault. Nothing broader." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#44546A;" vertex="1" parent="sec"><mxGeometry x="12" y="168" width="546" height="70" as="geometry" /></mxCell>
