        <mxCell id="backend" value="Deal Room backend&#10;ca-dealhub-orch&#10;&#10;API · agents · MCP&#10;the only tier that holds data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E74B5;strokeColor=#1F4E79;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="330" width="250" height="160" as="geometry" />
