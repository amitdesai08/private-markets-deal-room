        <mxCell id="console" value="Console tier&#10;ca-dealhub-teams&#10;&#10;holds no data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E74B5;fontColor=#10233E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="550" y="210" width="210" height="130" as="geometry" />
