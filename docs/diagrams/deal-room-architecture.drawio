        <mxCell id="t1" value="The Deal Room on Azure" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="t2" value="How a request travels, and what each resource group is for. Managed identity end to end — no keys in the app." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="20" as="geometry" /></mxCell>
