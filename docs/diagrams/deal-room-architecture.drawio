        <mxCell id="l3" value="- - - identity, RBAC and secrets" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A3D07;" vertex="1" parent="leg"><mxGeometry x="12" y="78" width="266" height="18" as="geometry" /></mxCell>
