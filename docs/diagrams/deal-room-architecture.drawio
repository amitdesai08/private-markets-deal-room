        <mxCell id="t1" value="The Deal Room — one backend, two surfaces" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="The console tier holds no data. Every read and write is forwarded to the one backend, so there is a single source of truth and nothing to keep in sync." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#44546A;" vertex="1" parent="1">
