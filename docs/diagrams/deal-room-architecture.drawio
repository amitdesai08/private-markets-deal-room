        <mxCell id="teams" value="Teams channel tab&#10;+ conversational bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontColor=#10233E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="150" width="220" height="80" as="geometry" />
