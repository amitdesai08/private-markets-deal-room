        <mxCell id="l1" value="—— request traffic (north-south)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="leg"><mxGeometry x="12" y="34" width="266" height="18" as="geometry" /></mxCell>
