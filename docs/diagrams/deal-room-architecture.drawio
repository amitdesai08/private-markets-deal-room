  <diagram name="The identity trust seam" id="trust-seam">
    <mxGraphModel background="#FFFFFF" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s-t1" value="The identity trust seam" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s-t2" value="Access is decided on the server. A client may state who it is; it can never widen what it is allowed to see." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#44546A;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1 · A person opens the tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#333333;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2 · Console tier asks Microsoft Entra ID to sign them in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E74B5;fontColor=#10233E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="196" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3 · Entra returns a token carrying group and app-role claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontColor=#10233E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="282" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4 · Console tier calls /api with the resolved identity and the shared bot key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E74B5;fontColor=#10233E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="368" width="300" height="66" as="geometry" />
        </mxCell>

        <mxCell id="boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#C00000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="650" height="400" as="geometry" />
        </mxCell>
        <mxCell id="boundary-l" value="Trust boundary — the backend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#C00000;" vertex="1" parent="1">
          <mxGeometry x="440" y="96" width="360" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="5 · The asserted identity is honoured only if the bot key matches.&#10;Otherwise the caller is an unidentified default seat." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE9E9;strokeColor=#C00000;fontColor=#5B0000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="146" width="590" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6 · roleForUser — the highest-ranked match wins across the Entra group claim, the app-role claim and the configured id lists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#2E74B5;fontColor=#10233E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="242" width="590" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7 · Per-deal check — need-to-know, territory and the deal team.&#10;A confidential deal is refused before the role is consulted: only a name gets in." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE9E9;strokeColor=#C00000;fontColor=#5B0000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="338" width="590" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8 · The answer carries only what this seat may see" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#70AD47;fontColor=#1E3A1E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="440" width="590" height="56" as="geometry" />
        </mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#7F7F7F;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#7F7F7F;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#7F7F7F;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#C00000;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#2E74B5;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se6" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#2E74B5;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=none;rounded=1;html=1;strokeColor=#70AD47;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="An identity asserted without the bot key buys nothing,&#10;and rank buys nothing on a confidential deal." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#44546A;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="340" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Azure architecture" id="azure-architecture">
    <mxGraphModel background="#FFFFFF" dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="The Deal Room on Azure" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="t2" value="How a request travels, and what each resource group is for. Managed identity end to end — no keys in the app." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#44546A;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="20" as="geometry" /></mxCell>
        <mxCell id="m365" value="Your Microsoft 365 tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#A9C7E8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="330" as="geometry" /></mxCell>
        <mxCell id="users" value="" style="sketch=0;html=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=image;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="m365"><mxGeometry x="71" y="44" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="users_c" value="Deal professionals" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="m365"><mxGeometry x="48" y="96" width="94" height="30" as="geometry" /></mxCell>
        <mxCell id="entra" value="" style="sketch=0;html=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=image;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="m365"><mxGeometry x="211" y="44" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="entra_c" value="Microsoft Entra ID" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="m365"><mxGeometry x="188" y="96" width="94" height="30" as="geometry" /></mxCell>
        <mxCell id="chip1" value="Teams channel tab + bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C7E8;fontSize=11;fontColor=#10233E;" vertex="1" parent="m365"><mxGeometry x="12" y="150" width="306" height="30" as="geometry" /></mxCell>
        <mxCell id="chip2" value="SharePoint — the per-deal data room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C7E8;fontSize=11;fontColor=#10233E;" vertex="1" parent="m365"><mxGeometry x="12" y="186" width="306" height="30" as="geometry" /></mxCell>
        <mxCell id="chip3" value="M365 Copilot + hosted agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A9C7E8;fontSize=11;fontColor=#10233E;" vertex="1" parent="m365"><mxGeometry x="12" y="222" width="306" height="30" as="geometry" /></mxCell>
        <mxCell id="m365n" value="Deal material stays in the tenant. Who may see it is decided in the backend, never here." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#44546A;" vertex="1" parent="m365"><mxGeometry x="12" y="262" width="306" height="46" as="geometry" /></mxCell>
        <mxCell id="f6note" value="6 · provisions the per-deal Teams channel and SharePoint data room" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="360" height="24" as="geometry" /></mxCell>
        <mxCell id="ext" value="Keyless market data (internet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#A9C7E8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="330" height="150" as="geometry" /></mxCell>
        <mxCell id="globe" value="" style="sketch=0;html=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=image;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="ext"><mxGeometry x="54" y="46" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="globe_c" value="Public sources" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="ext"><mxGeometry x="31" y="98" width="94" height="30" as="geometry" /></mxCell>
        <mxCell id="extt" value="&lt;b&gt;SEC EDGAR &amp;#183; GLEIF &amp;#183; GDELT&lt;/b&gt;&lt;br&gt;Read-only, one way, and switchable off." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#10233E;" vertex="1" parent="ext"><mxGeometry x="136" y="50" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="legend" value="Reading the lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEECF9;strokeColor=#A9C7E8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="330" height="122" as="geometry" /></mxCell>
        <mxCell id="lg1" value="—— the request path, in order" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F4E79;fontStyle=1;" vertex="1" parent="legend"><mxGeometry x="12" y="34" width="306" height="18" as="geometry" /></mxCell>
